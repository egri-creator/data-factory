# === OBLIGATORIO para subir a Hugging Face ===
HF_USERNAME=tu_usuario_huggingface
HF_TOKEN=tu_token_de_huggingface

# === CONFIGURACIÓN PRINCIPAL ===
DATASET_NICHE=medical
EXAMPLES_PER_RUN=500
HUMANIZATION_LEVEL=extreme
DEDUP_THRESHOLD=0.82
MIN_LENGTH=80
MAX_LENGTH=3000

# === MÚLTIPLES MODELOS (gratuitos) ===
# Se usan aleatoriamente para que no haya fingerprint de un solo modelo
USE_HF=true
HF_MODELS=mistralai/Mistral-7B-Instruct-v0.2,google/gemma-2-2b-it,microsoft/Phi-3-mini-4k-instruct
# Si usas Ollama local:
USE_OLLAMA=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# === FORMATOS DE EXPORTACIÓN ===
EXPORT_FORMATS=jsonl,csv,alpaca,sharegpt,openai,chatml

# === SPLITS ===
VAL_SPLIT=0.1
TEST_SPLIT=0.1

# === WATERMARK (protege tu dataset contra copia) ===
WATERMARK_KEY=datafactory-v1
